+  {% for f in found_fields %}<div class="mb-3"><b>{{ f.doc_type }} · {{ f.name }}</b> — {{ f.verification }}<div class="quote">{{ f.quote }}</div><a href="{% url 'evidence_viewer' f.document_id %}?page={{ f.page|default:1 }}">Abrir PDF en p. {{ f.page }}</a></div>
+  {% empty %}<p class="text-muted">Sin evidencia registrada todavía.</p>{% endfor %}
+</section>
+
+{# 7. Bitácora, al final: es para la demostración, no para decidir. #}
+<details id="t8" class="panel mb-3">
+  <summary>Bitácora de agentes — qué hizo cada agente y en cuánto tiempo</summary>
+  <div class="panel-body"><div class="table-responsive"><table class="table table-sm bg-white"><thead><tr><th scope="col">Agente</th><th scope="col">Estado</th><th scope="col">Tiempo (ms)</th><th scope="col">Reintentos</th><th scope="col">Configuración</th><th scope="col">Error</th></tr></thead><tbody>
+  {% for r in runs %}<tr><td>{{ r.agent }}</td><td>{{ r.status }}</td><td>{{ r.duration_ms }}</td><td>{{ r.retries }}</td><td>{{ r.ruleset_version }}</td><td>{{ r.error }}</td></tr>{% empty %}<tr><td colspan="6" class="text-muted">Sin ejecuciones registradas.</td></tr>{% endfor %}
+  </tbody></table></div></div>
+</details>
+{% endblock %}
