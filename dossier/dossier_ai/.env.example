DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://dossier:dossier@localhost:5432/dossier
REDIS_URL=redis://localhost:6379/0
PRIVATE_STORAGE_ROOT=./private_storage
MAX_UPLOAD_MB=50
OCR_BACKEND=none            # none | tesseract | paddleocr
PADDLEOCR_LANG=es           # es | en | ch | latin (ver README_es.md)
PADDLEOCR_USE_ANGLE_CLS=true # clasificador de rotación/orientación (180°)
PADDLEOCR_USE_GPU=false     # true para usar aceleración CUDA
EXTRACTOR_BACKEND=labels    # labels | llm (Ollama local)
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
