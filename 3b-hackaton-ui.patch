+  <td>{{ r.category }}</td><td>{{ r.message }}</td></tr>{% empty %}<tr><td colspan="4" class="text-muted">Sin reglas evaluadas todavía.</td></tr>{% endfor %}
+  </tbody></table></div>
+</section>
+
+{# 6. Evidencia. #}
+<section id="t7" aria-labelledby="h-evidence" class="mb-3">
