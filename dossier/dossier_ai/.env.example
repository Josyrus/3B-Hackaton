DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://dossier:dossier@localhost:5432/dossier
REDIS_URL=redis://localhost:6379/0
PRIVATE_STORAGE_ROOT=./private_storage
MAX_UPLOAD_MB=50
OCR_BACKEND=none            # none | tesseract
EXTRACTOR_BACKEND=labels    # labels | llm (Ollama local)
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_NUM_CTX=16384           # ventana de contexto de Ollama (el valor por defecto de Ollama trunca documentos largos)
NARRATIVE_BACKEND=none      # none | llm  (el LLM solo redacta el resumen ejecutivo; nunca decide el veredicto)
OCR_LANG=spa                # idioma de Tesseract (instale tesseract-ocr-spa)
RULESET_FILE=               # opcional: rules/reglas_comite.json o un .yaml propio
